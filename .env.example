# China Travel Map — environment template
# Copy to .env on the deploy host and fill in real values. .env is gitignored.

# AMap JS API key (https://lbs.amap.com/dev/key/app)
# Required for the frontend map to load tiles and for the /v3/ip lookup.
AMAP_KEY=

# Token required to call /api/init and /api/seed (and any future admin routes).
# Generate with:  openssl rand -hex 32
SEED_TOKEN=

# Comma-separated list of allowed CORS origins. Defaults to http://localhost:8765
# when empty. In production set this to your real https://<domain>.
ALLOWED_ORIGINS=

# AMap securityJsCode (the second half of the AMap credential pair, used to
# sign requests from the JS SDK). Same source as AMAP_KEY; rotate together.
AMAP_SECRET=
